{% extends 'admin/base_admin.html.twig' %}

{% block title %}Announcements Management{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-bullhorn"></i> Announcements Management</h2>
        <a href="{{ path('admin_announcement_create') }}" class="btn btn-primary">
            <i class="fas fa-plus"></i> Create New Announcement
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle"></i> {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    <div class="card">
        <div class="card-body">
            {% if announcements|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Type</th>
                                <th>Content Preview</th>
                                <th>Created</th>
                                <th>Expiry</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for announcement in announcements %}
                                <tr>
                                    <td><strong>{{ announcement.title }}</strong></td>
                                    <td>
                                        {% if announcement.type == 'urgent' %}
                                            <span class="badge bg-danger">Urgent</span>
                                        {% elseif announcement.type == 'event' %}
                                            <span class="badge bg-warning">Event</span>
                                        {% elseif announcement.type == 'scholarship' %}
                                            <span class="badge bg-success">Scholarship</span>
                                        {% else %}
                                            <span class="badge bg-info">General</span>
                                        {% endif %}
                                    </td>
                                    <td>{{ announcement.content|length > 80 ? announcement.content|slice(0, 80) ~ '...' : announcement.content }}</td>
                                    <td>{{ announcement.createdAt|date('M d, Y') }}</td>
                                    <td>{{ announcement.expiryDate ? announcement.expiryDate|date('M d, Y') : 'No expiry' }}</td>
                                    <td>
                                        {% if announcement.isActive %}
                                            <span class="badge bg-success">Active</span>
                                        {% else %}
                                            <span class="badge bg-secondary">Inactive</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <a href="{{ path('admin_announcement_edit', {id: announcement.id}) }}" 
                                               class="btn btn-outline-primary" 
                                               title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a href="{{ path('admin_announcement_toggle', {id: announcement.id}) }}" 
                                               class="btn btn-outline-warning" 
                                               title="Toggle Active/Inactive">
                                                <i class="fas fa-toggle-on"></i>
                                            </a>
                                            <form method="post" 
                                                  action="{{ path('admin_announcement_delete', {id: announcement.id}) }}" 
                                                  style="display: inline;"
                                                  onsubmit="return confirm('Are you sure you want to delete this announcement?');">
                                                <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="text-center py-5">
                    <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                    <p class="text-muted">No announcements yet. Create your first announcement!</p>
                    <a href="{{ path('admin_announcement_create') }}" class="btn btn-primary mt-2">
                        <i class="fas fa-plus"></i> Create Announcement
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
