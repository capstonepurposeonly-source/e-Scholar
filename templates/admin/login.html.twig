<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login - NORSU Scholarship</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🎓</text></svg>">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@500;600;700&display=swap');

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
            color: #172b4d;
            overflow-x: hidden;
        }

        .login-bg {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-image: url('{{ asset("images/images.jpg") }}');
            background-position: center center;
            background-size: cover;
            background-repeat: no-repeat;
            z-index: 0;
        }

        .login-bg-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, rgba(8, 42, 84, 0.85), rgba(18, 83, 145, 0.75));
            backdrop-filter: blur(3px);
            z-index: 1;
            pointer-events: none;
        }

        .login-card {
            position: relative;
            z-index: 10;
            background: rgba(255, 255, 255, 0.98);
            border: 1px solid rgba(255, 255, 255, 0.7);
            border-radius: 22px;
            padding: 2.75rem 2.5rem;
            box-shadow: 0 24px 70px rgba(7, 29, 58, 0.35);
            max-width: 440px;
            width: 100%;
            text-align: center;
            animation: fadeInUp 0.5s ease-out;
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .logo-container {
            margin-bottom: 1rem;
        }

        .logo-container img {
            width: 88px;
            height: 88px;
            object-fit: contain;
            filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.1));
        }

        .login-title {
            color: #123f72;
            font-family: 'Poppins', sans-serif;
            font-size: 1.9rem;
            line-height: 1.2;
            font-weight: 700;
            letter-spacing: 0.035em;
            margin-bottom: 0.35rem;
        }

        .login-subtitle {
            color: #64748b;
            font-size: 0.92rem;
            line-height: 1.5;
            margin-bottom: 1.9rem;
        }

        .alert {
            padding: 0.8rem 0.9rem;
            border-radius: 10px;
            margin-bottom: 1.35rem;
            background: #fff1f0;
            border: 1px solid #ffd4d1;
            color: #b42318;
            font-size: 0.88rem;
            text-align: left;
            animation: shake 0.4s ease-in-out;
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-5px); }
            75% { transform: translateX(5px); }
        }

        .form-group {
            margin-bottom: 1.15rem;
            text-align: left;
        }

        .form-label {
            display: block;
            color: #334155;
            font-weight: 600;
            margin-bottom: 0.45rem;
            font-size: 0.86rem;
        }

        .form-control {
            width: 100%;
            padding: 0.9rem 1rem;
            border: 1px solid #d5deea;
            border-radius: 10px;
            font-size: 0.93rem;
            font-family: 'Inter', sans-serif;
            background: #f8fafc;
            color: #172b4d;
            transition: all 0.2s ease;
        }

        .form-control:focus {
            outline: none;
            border-color: #2874bd;
            background: #fff;
            box-shadow: 0 0 0 4px rgba(40, 116, 189, 0.13);
        }

        .form-control::placeholder {
            color: #9aa8b8;
        }

        .btn-access {
            width: 100%;
            padding: 0.95rem 1rem;
            margin-top: 0.5rem;
            background: #145a96;
            color: white;
            border: none;
            border-radius: 10px;
            font-family: 'Inter', sans-serif;
            font-size: 0.96rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-access:hover {
            background: #0e477b;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(20, 90, 150, 0.3);
        }

        .btn-access:active {
            transform: translateY(0);
        }

        .btn-register {
            display: block;
            width: 100%;
            padding: 0.95rem 1rem;
            margin-top: 0.85rem;
            background: transparent;
            color: #145a96;
            border: 2px solid #145a96;
            border-radius: 10px;
            font-family: 'Inter', sans-serif;
            font-size: 0.96rem;
            font-weight: 600;
            text-decoration: none;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-register:hover {
            background: #145a96;
            color: white;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(20, 90, 150, 0.3);
        }

        .btn-register:active {
            transform: translateY(0);
        }

        .btn-back-home {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            width: 100%;
            padding: 0.85rem 1rem;
            margin-top: 0.85rem;
            background: transparent;
            color: #64748b;
            border: 2px solid #cbd5e1;
            border-radius: 10px;
            font-family: 'Inter', sans-serif;
            font-size: 0.92rem;
            font-weight: 600;
            text-decoration: none;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-back-home:hover {
            background: #f1f5f9;
            border-color: #94a3b8;
            color: #334155;
            transform: translateY(-1px);
        }

        .btn-back-home:active {
            transform: translateY(0);
        }

        .btn-back-home i {
            font-size: 0.85rem;
        }

        @media (max-width: 500px) {
            body {
                padding: 1rem;
            }

            .login-card {
                padding: 2.25rem 1.5rem;
                border-radius: 18px;
            }

            .login-title {
                font-size: 1.7rem;
            }

            .logo-container img {
                width: 76px;
                height: 76px;
            }

            .form-control {
                font-size: 16px; /* Prevent zoom on iOS */
            }
        }
    </style>
</head>
<body>
    <div class="login-bg"></div>
    <div class="login-bg-overlay"></div>

    <div class="login-card">
        <div class="logo-container">
            <img src="{{ asset('images/scholarship.png') }}" alt="NORSU Logo">
        </div>

        <h1 class="login-title">NORSU</h1>
        <p class="login-subtitle">Scholarship Management System</p>

        {% if error %}
            <div class="alert" role="alert">
                <strong>⚠️ Login Failed:</strong><br>
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <form method="post" action="{{ path('admin_login') }}" novalidate>
            <div class="form-group">
                <label for="email" class="form-label">Institutional Email</label>
                <input type="email"
                       id="email"
                       name="_username"
                       class="form-control"
                       value="{{ last_username ?? '' }}"
                       required
                       autofocus
                       autocomplete="email"
                       placeholder="example@norsu.edu.ph">
            </div>

            <div class="form-group">
                <label for="password" class="form-label">Password</label>
                <input type="password"
                       id="password"
                       name="_password"
                       class="form-control"
                       required
                       autocomplete="current-password"
                       placeholder="••••••••">
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit" class="btn-access">
                Access Portal
            </button>
        </form>

        <a href="{{ path('admin_register') }}" class="btn-register">
            Create Admin Account
        </a>

        <a href="{{ path('app_landing') }}" class="btn-back-home">
            <i class="fa-solid fa-arrow-left"></i>
            Back to Home
        </a>
    </div>

    <script>
        // Auto-focus on password field if username is already filled
        document.addEventListener('DOMContentLoaded', function() {
            const emailInput = document.getElementById('email');
            const passwordInput = document.getElementById('password');
            
            if (emailInput.value.trim() !== '') {
                passwordInput.focus();
            }
        });
    </script>
</body>
</html>
