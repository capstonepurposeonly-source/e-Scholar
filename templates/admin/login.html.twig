{% extends 'base.html.twig' %}

{% block title %}Admin Login - NORSU Scholarship{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@500;600;700&display=swap');

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
            background: url('{{ asset('images/images.jpg') }}') center/cover no-repeat;
            position: relative;
            color: #172b4d;
        }

        body::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(8, 42, 84, 0.82), rgba(18, 83, 145, 0.72));
            backdrop-filter: blur(3px);
        }

        .login-card {
            position: relative;
            z-index: 1;
            background: rgba(255, 255, 255, 0.98);
            border: 1px solid rgba(255, 255, 255, 0.7);
            border-radius: 22px;
            padding: 2.75rem 2.5rem;
            box-shadow: 0 24px 70px rgba(7, 29, 58, 0.3);
            max-width: 440px;
            width: 100%;
            text-align: center;
        }

        .logo-container {
            margin-bottom: 1rem;
        }

        .logo-container img {
            width: 88px;
            height: 88px;
            object-fit: contain;
        }

        .login-title {
            color: #123f72;
            font-family: 'Poppins', sans-serif;
            font-size: 1.9rem;
            line-height: 1.2;
            font-weight: 700;
            letter-spacing: 0.035em;
            margin-bottom: 0.35rem;
        }

        .login-subtitle {
            color: #64748b;
            font-size: 0.92rem;
            line-height: 1.5;
            margin-bottom: 1.9rem;
        }

        .alert {
            padding: 0.8rem 0.9rem;
            border-radius: 10px;
            margin-bottom: 1.35rem;
            background: #fff1f0;
            border: 1px solid #ffd4d1;
            color: #b42318;
            font-size: 0.88rem;
            text-align: left;
        }

        .form-group {
            margin-bottom: 1.15rem;
            text-align: left;
        }

        .form-label {
            display: block;
            color: #334155;
            font-weight: 600;
            margin-bottom: 0.45rem;
            font-size: 0.86rem;
        }

        .form-control {
            width: 100%;
            padding: 0.9rem 1rem;
            border: 1px solid #d5deea;
            border-radius: 10px;
            font-size: 0.93rem;
            font-family: 'Inter', sans-serif;
            transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
            background: #f8fafc;
            color: #172b4d;
        }

        .form-control:focus {
            outline: none;
            border-color: #2874bd;
            background: #fff;
            box-shadow: 0 0 0 4px rgba(40, 116, 189, 0.13);
        }

        .form-control::placeholder {
            color: #9aa8b8;
        }

        .remember-section {
            display: flex;
            align-items: center;
            gap: 0.65rem;
            margin: 0.15rem 0 1.45rem;
        }

        .toggle-switch {
            position: relative;
            width: 42px;
            height: 23px;
            flex: 0 0 42px;
            cursor: pointer;
        }

        .toggle-switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

        .toggle-slider {
            position: absolute;
            cursor: pointer;
            inset: 0;
            background-color: #cbd5e1;
            transition: 0.25s;
            border-radius: 24px;
        }

        .toggle-slider:before {
            position: absolute;
            content: "";
            height: 17px;
            width: 17px;
            left: 3px;
            bottom: 3px;
            background-color: white;
            transition: 0.25s;
            border-radius: 50%;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.2);
        }

        .toggle-switch input:checked + .toggle-slider {
            background-color: #2874bd;
        }

        .toggle-switch input:checked + .toggle-slider:before {
            transform: translateX(19px);
        }

        .remember-section label:last-child {
            font-size: 0.86rem;
            color: #64748b;
            cursor: pointer;
        }

        .btn-access {
            width: 100%;
            padding: 0.95rem 1rem;
            background: #145a96;
            color: white;
            border: none;
            border-radius: 10px;
            font-family: 'Inter', sans-serif;
            font-size: 0.96rem;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
        }

        .btn-access:hover {
            background: #0e477b;
            transform: translateY(-1px);
            box-shadow: 0 8px 18px rgba(20, 90, 150, 0.24);
        }

        .footer-text {
            margin-top: 1.5rem;
            font-size: 0.8rem;
            color: #94a3b8;
        }

        @media (max-width: 500px) {
            body {
                padding: 1rem;
            }

            .login-card {
                padding: 2.25rem 1.5rem;
                border-radius: 18px;
            }

            .login-title {
                font-size: 1.7rem;
            }

            .logo-container img {
                width: 76px;
                height: 76px;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="login-card">
        <div class="logo-container">
            <img src="{{ asset('images/scholarship.png') }}" alt="NORSU Logo">
        </div>

        <h1 class="login-title">NORSU</h1>
        <p class="login-subtitle">Scholarship Management System</p>

        {% if error %}
            <div class="alert">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <form method="post" action="{{ path('admin_login') }}">
            <div class="form-group">
                <label for="email" class="form-label">Institutional Email</label>
                <input type="email"
                       id="email"
                       name="_username"
                       class="form-control"
                       value="{{ last_username }}"
                       required
                       autofocus
                       placeholder="example@norsu.edu.ph">
            </div>

            <div class="form-group">
                <label for="password" class="form-label">Password</label>
                <input type="password"
                       id="password"
                       name="_password"
                       class="form-control"
                       required
                       placeholder="••••••">
            </div>

            <div class="remember-section">
                <label class="toggle-switch">
                    <input type="checkbox" id="remember_me" name="_remember_me">
                    <span class="toggle-slider"></span>
                </label>
                <label for="remember_me">Remember session</label>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit" class="btn-access">
                Access Portal
            </button>
        </form>
    </div>
{% endblock %}
