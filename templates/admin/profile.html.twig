{% extends 'base.html.twig' %}

{% block title %}Administrator Profile - e-Scholar NORSU{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;450;500;550;600;650;700&family=Manrope:wght@400;500;600;650;700;750;800&display=swap">
    <style>
        :root {
            --navy: #142b35;
            --teal: #087e78;
            --teal-light: #e7f4ef;
            --bg: #f5f6f3;
            --ink: #20343d;
            --muted: #708087;
            --line: #e3e8e4;
            --white: #fff;
            --radius: 14px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background: var(--bg);
            color: var(--ink);
            font: 14px/1.5 'DM Sans', -apple-system, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }

        .profile-container {
            max-width: 800px;
            width: 100%;
            background: white;
            border-radius: 20px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.08);
            overflow: hidden;
        }

        .profile-header {
            background: linear-gradient(135deg, var(--navy) 0%, #1e5ba8 100%);
            padding: 3rem 2.5rem;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .profile-header::before {
            content: '';
            position: absolute;
            top: -50px;
            right: -50px;
            width: 200px;
            height: 200px;
            background: rgba(255,255,255,0.05);
            border-radius: 50%;
        }

        .profile-avatar {
            width: 120px;
            height: 120px;
            background: var(--teal);
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 48px;
            font-weight: 700;
            color: white;
            margin: 0 auto 1.5rem;
            border: 4px solid rgba(255,255,255,0.2);
            font-family: 'Manrope', sans-serif;
        }

        .profile-name {
            font-size: 28px;
            font-weight: 700;
            color: white;
            margin-bottom: 0.5rem;
            font-family: 'Manrope', sans-serif;
        }

        .profile-role {
            color: rgba(255,255,255,0.8);
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 600;
        }

        .profile-body {
            padding: 2.5rem;
        }

        .info-section {
            margin-bottom: 2rem;
        }

        .section-label {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--muted);
            font-weight: 650;
            margin-bottom: 1rem;
        }

        .info-card {
            background: var(--bg);
            border-radius: var(--radius);
            padding: 1.5rem;
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .info-icon {
            width: 48px;
            height: 48px;
            background: white;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            color: var(--teal);
            flex-shrink: 0;
        }

        .info-content {
            flex: 1;
        }

        .info-label {
            font-size: 12px;
            color: var(--muted);
            margin-bottom: 4px;
        }

        .info-value {
            font-size: 16px;
            font-weight: 600;
            color: var(--ink);
            font-family: 'Manrope', sans-serif;
        }

        .action-buttons {
            display: flex;
            gap: 1rem;
            margin-top: 2rem;
        }

        .btn {
            padding: 14px 24px;
            border-radius: 12px;
            border: none;
            font: inherit;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            transition: all 0.2s;
            flex: 1;
            justify-content: center;
        }

        .btn-primary {
            background: var(--teal);
            color: white;
        }

        .btn-primary:hover {
            background: #096e69;
            transform: translateY(-2px);
            box-shadow: 0 4px 16px rgba(8, 126, 120, 0.3);
        }

        .btn-secondary {
            background: white;
            color: var(--ink);
            border: 2px solid var(--line);
        }

        .btn-secondary:hover {
            background: var(--bg);
            border-color: var(--teal);
        }

        .flash-messages {
            margin-bottom: 2rem;
        }

        .alert {
            padding: 1rem 1.5rem;
            border-radius: var(--radius);
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 14px;
        }

        .alert-success {
            background: #e7f4ef;
            color: var(--teal);
            border: 1px solid var(--teal);
        }

        .security-note {
            background: #fff8e6;
            border: 1px solid #ffd966;
            border-radius: var(--radius);
            padding: 1.5rem;
            margin-top: 2rem;
            font-size: 13px;
            color: #665200;
        }

        .security-note strong {
            display: block;
            margin-bottom: 0.5rem;
            font-size: 14px;
        }

        @media (max-width: 600px) {
            .profile-container {
                margin: 1rem;
            }

            .profile-header {
                padding: 2rem 1.5rem;
            }

            .profile-body {
                padding: 1.5rem;
            }

            .action-buttons {
                flex-direction: column;
            }

            .btn {
                width: 100%;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="profile-container">
        <div class="profile-header">
            <div class="profile-avatar">
                {{ admin.fullName|slice(0, 2)|upper }}
            </div>
            <h1 class="profile-name">{{ admin.fullName }}</h1>
            <div class="profile-role">System Administrator</div>
        </div>

        <div class="profile-body">
            {% for message in app.flashes('success') %}
                <div class="alert alert-success">
                    <i class="fa-solid fa-circle-check"></i>
                    {{ message }}
                </div>
            {% endfor %}

            <div class="info-section">
                <div class="section-label">ACCOUNT INFORMATION</div>
                
                <div class="info-card">
                    <div class="info-icon">
                        <i class="fa-solid fa-user"></i>
                    </div>
                    <div class="info-content">
                        <div class="info-label">Full Name</div>
                        <div class="info-value">{{ admin.fullName }}</div>
                    </div>
                </div>

                <div class="info-card">
                    <div class="info-icon">
                        <i class="fa-solid fa-envelope"></i>
                    </div>
                    <div class="info-content">
                        <div class="info-label">Email Address</div>
                        <div class="info-value">{{ admin.email }}</div>
                    </div>
                </div>

                <div class="info-card">
                    <div class="info-icon">
                        <i class="fa-solid fa-shield-halved"></i>
                    </div>
                    <div class="info-content">
                        <div class="info-label">Account Type</div>
                        <div class="info-value">Administrator</div>
                    </div>
                </div>
            </div>

            <div class="action-buttons">
                <a href="{{ path('admin_profile_edit') }}" class="btn btn-primary">
                    <i class="fa-solid fa-pen-to-square"></i>
                    Edit Profile
                </a>
                <a href="{{ path('admin_dashboard') }}" class="btn btn-secondary">
                    <i class="fa-solid fa-arrow-left"></i>
                    Back to Dashboard
                </a>
            </div>

            <div class="security-note">
                <strong><i class="fa-solid fa-lock"></i> Security Notice</strong>
                You can update your profile information and change your password from the edit page. For security reasons, you'll need to enter your current password to make any changes.
            </div>
        </div>
    </div>
{% endblock %}
