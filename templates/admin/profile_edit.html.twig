{% extends 'base.html.twig' %}

{% block title %}Edit Profile - e-Scholar NORSU{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;450;500;550;600;650;700&family=Manrope:wght@400;500;600;650;700;750;800&display=swap">
    <style>
        :root {
            --navy: #142b35;
            --teal: #087e78;
            --teal-light: #e7f4ef;
            --bg: #f5f6f3;
            --ink: #20343d;
            --muted: #708087;
            --line: #e3e8e4;
            --white: #fff;
            --red: #b54f49;
            --radius: 14px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background: var(--bg);
            color: var(--ink);
            font: 14px/1.5 'DM Sans', -apple-system, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }

        .edit-container {
            max-width: 700px;
            width: 100%;
            background: white;
            border-radius: 20px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.08);
            overflow: hidden;
        }

        .edit-header {
            background: linear-gradient(135deg, var(--navy) 0%, #1e5ba8 100%);
            padding: 2.5rem;
            text-align: center;
            color: white;
        }

        .edit-icon {
            width: 80px;
            height: 80px;
            background: rgba(255,255,255,0.15);
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 36px;
            margin: 0 auto 1.5rem;
            border: 3px solid rgba(255,255,255,0.2);
        }

        .edit-title {
            font-size: 26px;
            font-weight: 700;
            margin-bottom: 0.5rem;
            font-family: 'Manrope', sans-serif;
        }

        .edit-subtitle {
            color: rgba(255,255,255,0.8);
            font-size: 14px;
        }

        .edit-body {
            padding: 2.5rem;
        }

        .alert {
            padding: 1rem 1.5rem;
            border-radius: var(--radius);
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 14px;
        }

        .alert-danger {
            background: #fdeeed;
            color: var(--red);
            border: 1px solid var(--red);
        }

        .alert-success {
            background: #e7f4ef;
            color: var(--teal);
            border: 1px solid var(--teal);
        }

        .form-section {
            margin-bottom: 2rem;
        }

        .section-title {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--muted);
            font-weight: 650;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: var(--ink);
            margin-bottom: 0.5rem;
        }

        .form-label .required {
            color: var(--red);
            margin-left: 2px;
        }

        .form-control {
            width: 100%;
            padding: 12px 16px;
            border: 2px solid var(--line);
            border-radius: 10px;
            font: inherit;
            font-size: 14px;
            color: var(--ink);
            background: white;
            transition: all 0.2s;
        }

        .form-control:focus {
            outline: none;
            border-color: var(--teal);
            background: var(--teal-light);
        }

        .form-control::placeholder {
            color: var(--muted);
        }

        .form-help {
            font-size: 12px;
            color: var(--muted);
            margin-top: 0.5rem;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .divider {
            height: 1px;
            background: var(--line);
            margin: 2rem 0;
        }

        .password-section {
            background: #fff8e6;
            border: 2px solid #ffd966;
            border-radius: var(--radius);
            padding: 1.5rem;
            margin-bottom: 2rem;
        }

        .password-section .section-title {
            color: #665200;
            margin-bottom: 1rem;
        }

        .password-section .form-help {
            color: #806600;
        }

        .form-actions {
            display: flex;
            gap: 1rem;
            margin-top: 2rem;
        }

        .btn {
            padding: 14px 24px;
            border-radius: 12px;
            border: none;
            font: inherit;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            transition: all 0.2s;
            flex: 1;
            justify-content: center;
        }

        .btn-primary {
            background: var(--teal);
            color: white;
        }

        .btn-primary:hover {
            background: #096e69;
            transform: translateY(-2px);
            box-shadow: 0 4px 16px rgba(8, 126, 120, 0.3);
        }

        .btn-secondary {
            background: white;
            color: var(--ink);
            border: 2px solid var(--line);
        }

        .btn-secondary:hover {
            background: var(--bg);
            border-color: var(--teal);
        }

        .security-notice {
            background: var(--teal-light);
            border: 1px solid var(--teal);
            border-radius: var(--radius);
            padding: 1.5rem;
            margin-top: 2rem;
            font-size: 13px;
            color: var(--teal);
        }

        .security-notice strong {
            display: block;
            margin-bottom: 0.5rem;
            font-size: 14px;
        }

        @media (max-width: 600px) {
            .edit-container {
                margin: 1rem;
            }

            .edit-header,
            .edit-body {
                padding: 1.5rem;
            }

            .form-actions {
                flex-direction: column;
            }

            .btn {
                width: 100%;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="edit-container">
        <div class="edit-header">
            <div class="edit-icon">
                <i class="fa-solid fa-user-pen"></i>
            </div>
            <h1 class="edit-title">Edit Your Profile</h1>
            <p class="edit-subtitle">Update your account information and security settings</p>
        </div>

        <div class="edit-body">
            {% if error %}
                <div class="alert alert-danger">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    {{ error }}
                </div>
            {% endif %}

            {% if success %}
                <div class="alert alert-success">
                    <i class="fa-solid fa-circle-check"></i>
                    Profile updated successfully!
                </div>
            {% endif %}

            <form method="post" action="{{ path('admin_profile_edit') }}">
                <div class="form-section">
                    <div class="section-title">
                        <i class="fa-solid fa-id-card"></i>
                        BASIC INFORMATION
                    </div>

                    <div class="form-group">
                        <label for="full_name" class="form-label">
                            Full Name <span class="required">*</span>
                        </label>
                        <input 
                            type="text" 
                            id="full_name" 
                            name="full_name" 
                            class="form-control"
                            value="{{ admin.fullName }}"
                            required
                            placeholder="Enter your full name">
                    </div>

                    <div class="form-group">
                        <label for="email" class="form-label">
                            Email Address <span class="required">*</span>
                        </label>
                        <input 
                            type="email" 
                            id="email" 
                            name="email" 
                            class="form-control"
                            value="{{ admin.email }}"
                            required
                            placeholder="your.email@norsu.edu.ph">
                        <div class="form-help">
                            <i class="fa-solid fa-circle-info"></i>
                            This will be used for login and notifications
                        </div>
                    </div>
                </div>

                <div class="divider"></div>

                <div class="password-section">
                    <div class="section-title">
                        <i class="fa-solid fa-key"></i>
                        CHANGE PASSWORD (Optional)
                    </div>
                    <p style="font-size: 13px; color: #806600; margin-bottom: 1.5rem;">
                        Leave these fields blank if you don't want to change your password.
                    </p>

                    <div class="form-group">
                        <label for="current_password" class="form-label">
                            Current Password
                        </label>
                        <input 
                            type="password" 
                            id="current_password" 
                            name="current_password" 
                            class="form-control"
                            placeholder="Enter your current password"
                            autocomplete="current-password">
                        <div class="form-help">
                            <i class="fa-solid fa-shield-halved"></i>
                            Required to change password
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="new_password" class="form-label">
                            New Password
                        </label>
                        <input 
                            type="password" 
                            id="new_password" 
                            name="new_password" 
                            class="form-control"
                            placeholder="Enter new password (min. 6 characters)"
                            autocomplete="new-password">
                    </div>

                    <div class="form-group">
                        <label for="confirm_password" class="form-label">
                            Confirm New Password
                        </label>
                        <input 
                            type="password" 
                            id="confirm_password" 
                            name="confirm_password" 
                            class="form-control"
                            placeholder="Re-enter new password"
                            autocomplete="new-password">
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-floppy-disk"></i>
                        Save Changes
                    </button>
                    <a href="{{ path('admin_profile') }}" class="btn btn-secondary">
                        <i class="fa-solid fa-xmark"></i>
                        Cancel
                    </a>
                </div>

                <div class="security-notice">
                    <strong><i class="fa-solid fa-lock"></i> Security Information</strong>
                    Your password is encrypted and cannot be viewed by anyone. For your security, choose a strong password with at least 6 characters.
                </div>
            </form>
        </div>
    </div>
{% endblock %}
