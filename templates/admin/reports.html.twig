{% extends 'admin/base_admin.html.twig' %}

{% block title %}Reports & Activity - e-Scholar NORSU{% endblock %}
{% block page_title %}Reports & Activity{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 24px;
        }

        .stat-card {
            background: white;
            border: 1px solid var(--line);
            border-radius: var(--radius);
            padding: 20px;
        }

        .stat-label {
            font-size: 13px;
            color: var(--muted);
            font-weight: 500;
            margin-bottom: 12px;
        }

        .stat-value {
            font-size: 32px;
            font-weight: 700;
            color: var(--ink);
            font-family: 'Manrope', sans-serif;
        }

        .chart-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 24px;
        }

        .btn {
            padding: 10px 18px;
            border-radius: 10px;
            border: none;
            font: inherit;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
            transition: all 0.15s;
        }

        .btn-primary {
            background: var(--teal);
            color: white;
        }

        .btn-primary:hover {
            background: #096e69;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(8, 126, 120, 0.3);
        }

        .btn-secondary {
            background: white;
            color: var(--ink);
            border: 1px solid var(--line);
        }

        .btn-secondary:hover {
            background: var(--bg);
            border-color: var(--teal);
        }
    </style>
{% endblock %}

{% block page_content %}
    <div style="margin-bottom: 24px; display: flex; gap: 12px;">
        <a href="{{ path('admin_export_students') }}" class="btn btn-primary" style="text-decoration: none; display: inline-flex; align-items: center; gap: 8px;">
            <i class="fa-solid fa-download"></i>
            Export All Students to CSV
        </a>
        <button onclick="openInGoogleSheets()" class="btn btn-secondary" style="display: inline-flex; align-items: center; gap: 8px;">
            <i class="fa-brands fa-google"></i>
            Open in Google Sheets
        </button>
    </div>

    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-label">Total Students</div>
            <div class="stat-value">{{ stats.total_students }}</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Enrolled</div>
            <div class="stat-value">{{ stats.enrolled }}</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Male Students</div>
            <div class="stat-value">{{ stats.male_students }}</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Female Students</div>
            <div class="stat-value">{{ stats.female_students }}</div>
        </div>
    </div>

    <div class="chart-row">
        <div class="panel">
            <div class="panel-header">
                <div>
                    <h3 class="panel-title">Scholarship Distribution</h3>
                    <p class="panel-subtitle">Students by scholarship type</p>
                </div>
            </div>
            <table class="directory-table">
                <thead>
                    <tr>
                        <th>SCHOLARSHIP TYPE</th>
                        <th>STUDENTS</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in scholarshipStats %}
                        <tr>
                            <td>{{ row.scholarship_type }}</td>
                            <td><strong>{{ row.count }}</strong></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="panel">
            <div class="panel-header">
                <div>
                    <h3 class="panel-title">Campus Distribution</h3>
                    <p class="panel-subtitle">Students by campus</p>
                </div>
            </div>
            <table class="directory-table">
                <thead>
                    <tr>
                        <th>CAMPUS</th>
                        <th>STUDENTS</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in campusStats %}
                        <tr>
                            <td>{{ row.campus_name }}</td>
                            <td><strong>{{ row.count }}</strong></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        function openInGoogleSheets() {
            // Download CSV first
            const exportUrl = '{{ path('admin_export_students') }}';
            
            // Create temporary link and trigger download
            const link = document.createElement('a');
            link.href = exportUrl;
            link.download = 'students_export_' + new Date().toISOString().slice(0,10) + '.csv';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            
            // Show instructions
            setTimeout(() => {
                alert('CSV file downloaded!\n\nTo open in Google Sheets:\n\n1. Go to sheets.google.com\n2. Click "File" → "Import"\n3. Upload the downloaded CSV file\n4. Choose "Replace spreadsheet" or "Create new spreadsheet"\n5. Click "Import data"\n\nThe CSV file has been saved to your Downloads folder.');
            }, 500);
        }
    </script>
{% endblock %}
