{% extends 'admin/base_admin.html.twig' %}

{% block title %}Reports & Activity - e-Scholar NORSU{% endblock %}
{% block page_title %}Reports & Activity{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 24px;
        }

        .stat-card {
            background: white;
            border: 1px solid var(--line);
            border-radius: var(--radius);
            padding: 20px;
        }

        .stat-label {
            font-size: 13px;
            color: var(--muted);
            font-weight: 500;
            margin-bottom: 12px;
        }

        .stat-value {
            font-size: 32px;
            font-weight: 700;
            color: var(--ink);
            font-family: 'Manrope', sans-serif;
        }

        .chart-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 24px;
        }
    </style>
{% endblock %}

{% block page_content %}
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-label">Total Students</div>
            <div class="stat-value">{{ stats.total_students }}</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Enrolled</div>
            <div class="stat-value">{{ stats.enrolled }}</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Male Students</div>
            <div class="stat-value">{{ stats.male_students }}</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Female Students</div>
            <div class="stat-value">{{ stats.female_students }}</div>
        </div>
    </div>

    <div class="chart-row">
        <div class="panel">
            <div class="panel-header">
                <div>
                    <h3 class="panel-title">Scholarship Distribution</h3>
                    <p class="panel-subtitle">Students by scholarship type</p>
                </div>
            </div>
            <table class="directory-table">
                <thead>
                    <tr>
                        <th>SCHOLARSHIP TYPE</th>
                        <th>STUDENTS</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in scholarshipStats %}
                        <tr>
                            <td>{{ row.scholarship_type }}</td>
                            <td><strong>{{ row.count }}</strong></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="panel">
            <div class="panel-header">
                <div>
                    <h3 class="panel-title">Campus Distribution</h3>
                    <p class="panel-subtitle">Students by campus</p>
                </div>
            </div>
            <table class="directory-table">
                <thead>
                    <tr>
                        <th>CAMPUS</th>
                        <th>STUDENTS</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in campusStats %}
                        <tr>
                            <td>{{ row.campus_name }}</td>
                            <td><strong>{{ row.count }}</strong></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
