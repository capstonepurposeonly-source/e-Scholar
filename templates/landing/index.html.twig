{% extends 'base.html.twig' %}

{% block title %}Negros Oriental State University - Scholarship
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<style>
		* {
			margin: 0;
			padding: 0;
			box-sizing: border-box;
		}

		body {
			font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
			background: #f5f5f5;
			color: #333;
		}

		@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800 &display=swap');

		/* Navigation */
		.navbar {
			background: #ffffff;
			padding: 1rem 0;
			position: sticky;
			top: 0;
			z-index: 1000;
		}

		.nav-container {
			max-width: 100%;
			margin: 0;
			padding: 0 2rem;
			display: flex;
			justify-content: space-between;
			align-items: center;
			background: #ffffff;
		}

		.nav-logo {
			display: flex;
			align-items: center;
			gap: 0.75rem;
			color: #001f3f;
			text-decoration: none;
			font-family: Poppins;
			font-weight: 600;
		}

		.nav-logo img {
			width: 50px;
			height: 50px;
		}

		.nav-brand {
			font-size: 1.1rem;
			font-weight: 1000;
			letter-spacing: 0.5px;
			display: block;
		}

		.nav-brand-wrapper {
			display: flex;
			flex-direction: column;
			gap: 0.1rem;
		}

		.nav-subtitle {
			font-size: 0.75rem;
			font-weight: 400;
			color: #666;
			letter-spacing: 0.3px;
		}

		.nav-menu {
			display: flex;
			gap: 2rem;
			list-style: none;
			align-items: center;
		}

		.nav-menu a {
			color: white;
			text-decoration: none;
			font-weight: 500;
			transition: opacity 0.3s;
			display: flex;
			align-items: center;
			gap: 0.5rem;
		}

		.nav-menu a:hover {
			opacity: 0.8;
		}

		.nav-menu a button {
			cursor: pointer;
		}

		.nav-menu button {
			display: flex;
			align-items: center;
			gap: 0.5rem;
		}

		.btn-adlog {
			background: #ffc107;
			color: #1e5ba8;
			padding: 0.6rem 1.5rem;
			border-radius: 5px;
			font-weight: 600;
			border: none;
			cursor: pointer;
			transition: all 0.3s;
		}

		.btn-adlog:hover {
			background: #ffcd38;
			transform: translateY(-1px);
		}

		.btn-studportal {
			background: #ffc107;
			color: #1e5ba8;
			padding: 0.6rem 1.5rem;
			border-radius: 5px;
			font-weight: 600;
			border: none;
			cursor: pointer;
			transition: all 0.3s;
		}

		.btn-studportal:hover {
			background: #ffcd38;
			transform: translateY(-1px);
		}

		.btn-prog {
			background: rgb(233, 235, 248);
			color: #1e5ba8;
			padding: 0.6rem 1.5rem;
			border-radius: 5px;
			font-weight: 600;
			border: none;
			cursor: pointer;
			transition: all 0.3s;
		}

		.btn-prog:hover {
			background: #ffffffff;
			transform: translateY(-1px);
		}

		.btn-acscho {
			background:  rgb(233, 235, 248);
			color: #1e5ba8;
			padding: 0.6rem 1.5rem;
			border-radius: 5px;
			font-weight: 600;
			border: none;
			cursor: pointer;
			transition: all 0.3s;
		}

		.btn-acscho:hover {
			background: #ffffffff;
			transform: translateY(-1px);
		}

		.btn-track {
			background:  rgb(233, 235, 248);
			color: #1e5ba8;
			padding: 0.6rem 1.5rem;
			border-radius: 5px;
			font-weight: 600;
			border: none;
			cursor: pointer;
			transition: all 0.3s;
		}

		.btn-track:hover {
			background: #ffffffff;
			transform: translateY(-1px);
		}

		/* Hero Section */
		.hero {
			background: linear-gradient(rgba(30, 91, 168, 0.55), rgba(30, 91, 168, 0.72)), url('{{ asset('images/negrosorientalstateuniversity_cover.jpg') }}') center center / cover no-repeat;
			padding: 3rem 2rem;
			color: white;
			min-height: 550px;
			display: flex;
			align-items: center;
			position: relative;
			border-radius: 30px;
			margin: 0.25rem 2rem 2rem 2rem;
		}

		.hero-content {
			max-width: 1500px;
			margin: 0 0 0 3rem;
			text-align: left;
		}

		.hero h1 {
			font-family: 'Poppins', sans-serif;
			font-size: 5.2rem;
			margin-bottom: 0.5rem;
			line-height: 1.1;
			font-weight: 1000;
			color: white;
			text-shadow: 2px 2px 4px rgba(6, 4, 4, 0.65);
		}

		.hero-subtitle {
			font-family: 'Poppins', sans-serif;
			font-size: 1.1rem;
			font-style: italic;
			font-weight: 400;
			color: #ffffffff;
			text-shadow: 2px 2px 4px rgba(6, 4, 4, 0.65);
			margin-top: 1.5rem;
			margin-bottom: 0.5rem;
			line-height: 1.6;
			max-width: 800px;
		}

		.hero p {
			font-family: 'Poppins';
			font-size: 1.5rem;
			margin-bottom: 2rem;
		}

		.hero-buttons {
			display: flex;
			gap: 1rem;
			justify-content: flex-start;
			flex-wrap: wrap;
			margin-top: 2rem;
		}

		.btn {
			font-family: 'Poppins', sans-serif;
			padding: 1rem 2.5rem;
			font-size: 1.1rem;
			font-weight: 600;
			border: none;
			border-radius: 5px;
			cursor: pointer;
			transition: all 0.3s;
			text-decoration: none;
			display: inline-block;
		}

		.btn-yellow {
			background: #ffc107;
			color: #1e5ba8;
			box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
		}

		.btn-yellow:hover {
			background: #ffcd38;
			transform: translateY(-2px);
			box-shadow: 0 6px 15px rgba(0, 0, 0, 0.3);
		}

		/* Quick Links / Scholarship Partners */
		.quick-links {
			background: #fcfcfcff;
			padding: 1rem;
		}

		.quick-links-container {
			max-width: 1200px;
			margin: 0 auto;
			display: grid;
			grid-template-columns: repeat(9, 1fr);
			gap: 2rem;
			align-items: center;
		}

		.quick-link-item {
			text-align: center;
			padding: 1rem;
			transition: background 0.3s, transform 0.3s;
			border-radius: 8px;
			cursor: pointer;
			display: flex;
			align-items: center;
			justify-content: center;
			background: rgba(255, 255, 255, 0.95);
			text-decoration: none;
		}

		.quick-link-item:hover {
			background: rgba(255, 255, 255, 1);
			transform: translateY(-3px);
			box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
		}

		.quick-link-logo {
			width: 80px;
			height: 80px;
			display: flex;
			align-items: center;
			justify-content: center;
		}

		.quick-link-logo img {
			width: 100%;
			height: 100%;
			object-fit: contain;
		}

		.quick-link-icon {
			font-size: 2.5rem;
			margin-bottom: 0.5rem;
		}

		.quick-link-text {
			font-size: 0.9rem;
			font-weight: 600;
		}

		/* Video Section */
		.video-section {
			padding: 6rem 4rem;
			background: linear-gradient(135deg, #ffffff 0%, #f0f4f8 100%);
			position: relative;
			overflow: hidden;
		}

		.video-section::before {
			content: '';
			position: absolute;
			top: -50%;
			right: -10%;
			width: 500px;
			height: 500px;
			background: radial-gradient(circle, rgba(30, 91, 168, 0.08) 0%, transparent 70%);
			border-radius: 50%;
		}

		.video-section::after {
			content: '';
			position: absolute;
			bottom: -30%;
			left: -5%;
			width: 400px;
			height: 400px;
			background: radial-gradient(circle, rgba(255, 193, 7, 0.08) 0%, transparent 70%);
			border-radius: 50%;
		}

		.video-content {
			max-width: 1400px;
			margin: 0 auto;
			display: grid;
			grid-template-columns: 1fr 1.2fr;
			gap: 5rem;
			align-items: center;
			padding: 0 2rem;
			position: relative;
			z-index: 1;
		}

		.video-text {
			font-family: 'Poppins', sans-serif;
			padding-right: 2rem;
		}

		.video-text h2 {
			font-family: 'Poppins', sans-serif;
			color: #1e5ba8;
			font-size: 2.8rem;
			font-weight: 800;
			margin-bottom: 1rem;
			line-height: 1.2;
			position: relative;
			display: inline-block;
		}

		.video-text h2::after {
			content: '';
			position: absolute;
			bottom: -10px;
			left: 0;
			width: 80px;
			height: 4px;
			background: linear-gradient(90deg, #1e5ba8, #ffc107);
			border-radius: 2px;
		}

		.video-text h3 {
			font-family: 'Poppins', sans-serif;
			color: #ffc107;
			font-size: 1.5rem;
			font-weight: 600;
			margin: 2rem 0 1.5rem;
			letter-spacing: 0.5px;
		}

		.video-text p {
			font-family: 'Poppins', sans-serif;
			line-height: 1.9;
			color: #555;
			margin-bottom: 1.25rem;
			font-size: 1.05rem;
			text-align: justify;
		}

		.video-container {
			position: relative;
			width: 100%;
			height: 500px;
			border-radius: 20px;
			box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2);
			background: #000;
			overflow: hidden;
			transition: transform 0.3s, box-shadow 0.3s;
		}

		.video-container:hover {
			transform: translateY(-10px);
			box-shadow: 0 30px 80px rgba(0, 0, 0, 0.25);
		}

		.video-container::before {
			content: '';
			position: absolute;
			inset: -3px;
			background: linear-gradient(135deg, #1e5ba8, #ffc107, #1e5ba8);
			border-radius: 20px;
			z-index: -1;
			opacity: 0;
			transition: opacity 0.3s;
		}

		.video-container:hover::before {
			opacity: 0.7;
		}

		.video-container video {
			position: absolute;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			border: none;
			border-radius: 20px;
			object-fit: cover;
			background: #000;
		}

		/* Document Request Process Section */
		.process-section {
			background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
			padding: 6rem 2rem;
			position: relative;
			overflow: hidden;
		}

		.process-section::before {
			content: '';
			position: absolute;
			top: -100px;
			right: -100px;
			width: 400px;
			height: 400px;
			background: radial-gradient(circle, rgba(30, 91, 168, 0.05) 0%, transparent 70%);
			border-radius: 50%;
		}

		.process-container {
			max-width: 1200px;
			margin: 0 auto;
			position: relative;
			z-index: 1;
		}

		.process-header {
			text-align: center;
			margin-bottom: 4rem;
		}

		.process-header h2 {
			font-family: 'Poppins', sans-serif;
			color: #1e5ba8;
			font-size: 3rem;
			font-weight: 800;
			margin-bottom: 1rem;
			position: relative;
			display: inline-block;
		}

		.process-header h2::after {
			content: '';
			position: absolute;
			bottom: -10px;
			left: 50%;
			transform: translateX(-50%);
			width: 100px;
			height: 4px;
			background: linear-gradient(90deg, #1e5ba8, #ffc107);
			border-radius: 2px;
		}

		.process-header p {
			font-family: 'Poppins', sans-serif;
			color: #555;
			font-size: 1.2rem;
			margin-top: 1.5rem;
			max-width: 700px;
			margin-left: auto;
			margin-right: auto;
			line-height: 1.7;
		}

		.process-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
			gap: 3rem;
			margin-top: 3rem;
		}

		.process-step {
			background: white;
			padding: 2.5rem 2rem;
			border-radius: 15px;
			box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
			position: relative;
			transition: all 0.3s ease;
			border-top: 4px solid transparent;
		}

		.process-step:hover {
			transform: translateY(-10px);
			box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);
			border-top-color: #1e5ba8;
		}

		.process-step-number {
			position: absolute;
			top: -20px;
			left: 50%;
			transform: translateX(-50%);
			width: 50px;
			height: 50px;
			background: linear-gradient(135deg, #1e5ba8, #2a6fc7);
			color: white;
			border-radius: 50%;
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 1.5rem;
			font-weight: 700;
			box-shadow: 0 4px 15px rgba(30, 91, 168, 0.3);
		}

		.process-step-icon {
			font-size: 3rem;
			text-align: center;
			margin: 1rem 0;
			color: #1e5ba8;
		}

		.process-step h3 {
			font-family: 'Poppins', sans-serif;
			color: #1e5ba8;
			font-size: 1.4rem;
			font-weight: 700;
			margin-bottom: 1rem;
			text-align: center;
		}

		.process-step p {
			font-family: 'Poppins', sans-serif;
			color: #666;
			font-size: 1rem;
			line-height: 1.7;
			text-align: center;
		}

		.process-cta {
			text-align: center;
			margin-top: 4rem;
		}

		.process-cta .btn {
			background: linear-gradient(135deg, #ffc107, #ffcd38);
			color: #1e5ba8;
			padding: 1.2rem 3rem;
			font-size: 1.2rem;
			font-weight: 700;
			border-radius: 50px;
			box-shadow: 0 5px 20px rgba(255, 193, 7, 0.4);
			transition: all 0.3s ease;
		}

		.process-cta .btn:hover {
			background: linear-gradient(135deg, #ffcd38, #ffe066);
			transform: translateY(-3px);
			box-shadow: 0 8px 30px rgba(255, 193, 7, 0.5);
		}

		.certificate-types {
			background: white;
			padding: 3rem;
			border-radius: 15px;
			margin-top: 3rem;
			box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
		}

		.certificate-types h3 {
			font-family: 'Poppins', sans-serif;

			color: #1e5ba8;
			font-size: 1.8rem;
			font-weight: 700;
			margin-bottom: 1.5rem;
			text-align: center;
		}

		.certificate-list {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
			gap: 1.5rem;
			margin-top: 2rem;
		}

		.certificate-item {
			background: #f8f9fa;
			padding: 1.5rem;
			border-radius: 10px;
			border-left: 4px solid #ffc107;
			transition: all 0.3s ease;
		}

		.certificate-item:hover {
			background: #fff;
			box-shadow: 0 3px 15px rgba(0, 0, 0, 0.1);
			transform: translateX(5px);
		}

		.certificate-item h4 {
			font-family: 'Poppins', sans-serif;
			color: #1e5ba8;
			font-size: 1.1rem;
			font-weight: 600;
			margin-bottom: 0.5rem;
			display: flex;
			align-items: center;
			gap: 0.5rem;
		}

		.certificate-item p {
			font-family: 'Poppins', sans-serif;
			color: #666;
			font-size: 0.9rem;
			line-height: 1.5;
		}

		/* About Section */
		.about-section {
			padding: 4rem 2rem;
			background: #f9f9f9;
		}

		.about-content {
			max-width: 1200px;
			margin: 0 auto;
			display: grid;
			grid-template-columns: 2fr 1fr;
			gap: 4rem;
			align-items: center;
		}

		.about-text {
			font-family: 'Poppins', sans-serif;
		}

		.about-text h2 {
			font-family: 'Poppins', sans-serif;
			color: #1e5ba8;
			font-size: 2.5rem;
			font-weight: 700;
			margin-bottom: 1rem;
		}

		.about-text h3 {
			font-family: 'Poppins', sans-serif;
			color: #1e5ba8;
			font-size: 1.3rem;
			font-weight: 600;
			margin: 1.5rem 0 1rem;
		}

		.about-text p {
			font-family: 'Poppins', sans-serif;
			line-height: 1.8;
			color: #555;
			margin-bottom: 1rem;
			font-size: 1rem;
		}

		.about-images {
			display: flex;
			flex-direction: column;
			gap: 2rem;
			align-items: center;
		}

		.about-images img {
			width: 200px;
			height: 200px;
			object-fit: contain;
			background: white;
			padding: 1.5rem;
			border-radius: 15px;
			box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
		}

		.about-image {
			width: 100%;
			height: 180px;
			background: #e0e0e0;
			border-radius: 10px;
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 3rem;
		}

		.btn-link {
			font-family: 'Poppins', sans-serif;
			color: #1e5ba8;
			font-weight: 600;
			text-decoration: none;
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			margin-top: 1rem;
		}

		/* Campus Section */
		.campus-section {
			background: #1e5ba8;
			padding: 4rem 2rem;
			color: white;
		}

		.campus-content {
			max-width: 1200px;
			margin: 0 auto;
			display: grid;
			grid-template-columns: 2fr 1fr;
			gap: 3rem;
			align-items: center;
		}

		.campus-info h2 {
			font-size: 2rem;
			margin-bottom: 1rem;
		}

		.campus-location {
			display: flex;
			align-items: center;
			gap: 0.5rem;
			font-size: 1rem;
		}

		.campus-image {
			width: 100%;
			height: 250px;
			background: rgba(255, 255, 255, 0.1);
			border-radius: 10px;
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 4rem;
		}

		@media(max-width: 768px) {
			.nav-menu {
				display: none;
			}

			.hero h1 {
				font-size: 2.5rem;
			}

			.about-content,
			.campus-content,
			.video-content {
				grid-template-columns: 1fr;
				padding: 0 1rem;
			}

			.programs-grid {
				grid-template-columns: 1fr;
			}

			.quick-links-container {
				grid-template-columns: repeat(3, 1fr);
				gap: 1rem;
			}

			.quick-link-logo {
				width: 60px;
				height: 60px;
			}

			.video-container {
				height: 300px;
				margin-left: 0;
			}

			.video-text {
				padding-right: 0;
			}

			.video-text h2 {
				font-size: 2rem;
			}

			.video-text h3 {
				font-size: 1.2rem;
			}

			.video-section {
				padding: 4rem 2rem;
			}

			.process-header h2 {
				font-size: 2rem;
			}

			.process-header p {
				font-size: 1rem;
			}

			.process-grid {
				grid-template-columns: 1fr;
				gap: 2rem;
			}

			.certificate-list {
				grid-template-columns: 1fr;
			}

			.certificate-types {
				padding: 2rem 1.5rem;
			}
		}

		@media(min-width: 769px) and(max-width: 1024px) {
			.programs-grid {
				grid-template-columns: repeat(2, 1fr);
			}

			.quick-links-container {
				grid-template-columns: repeat(5, 1fr);
			}

			.quick-link-logo {
				width: 70px;
				height: 70px;
			}

			.video-container {
				height: 400px;
				margin-left: 1rem;
			}

			.video-content {
				gap: 3rem;
				padding: 0 1rem;
			}

			.video-text h2 {
				font-size: 2.2rem;
			}

			.process-grid {
				grid-template-columns: repeat(2, 1fr);
			}

			.process-header h2 {
				font-size: 2.5rem;
			}
		}

/* ============= NORSU scholarship visual refresh ============= */
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
:root{--ns-navy:#102f56;--ns-blue:#165ca5;--ns-gold:#f3bd45;--ns-ink:#142a43;--ns-muted:#65758a;--ns-bg:#f5f8fc;--ns-line:#e6ecf3;--ns-radius:20px;--ns-shadow:0 16px 45px rgba(24,54,90,.075)}
html{scroll-behavior:smooth;scroll-padding-top:100px}
body{background:var(--ns-bg);color:var(--ns-ink);font-family:'DM Sans',sans-serif}
body button,body a{font-family:inherit}
.navbar{border-bottom:1px solid var(--ns-line);box-shadow:0 3px 22px rgba(17,44,74,.045);padding:0}
.nav-container{max-width:1440px;margin:auto;padding:15px clamp(20px,4vw,56px);gap:24px}
.nav-logo{min-width:230px;color:var(--ns-navy)}
.nav-logo img{height:48px;width:48px;object-fit:contain}
.nav-brand{font-family:'Plus Jakarta Sans',sans-serif;font-size:1rem;font-weight:800;letter-spacing:-.035em}
.nav-subtitle{font-size:.72rem;color:var(--ns-muted);letter-spacing:0}
.nav-menu{gap:8px}
.nav-menu li{list-style:none}
.nav-menu button{white-space:nowrap;border:1px solid transparent!important;padding:11px 14px!important;border-radius:11px!important;font-size:.84rem;font-weight:700;transition:background .2s,transform .2s,box-shadow .2s}
.btn-prog,.btn-acscho,.btn-track{background:transparent!important;color:#334e6b!important}
.btn-prog:hover,.btn-acscho:hover,.btn-track:hover{background:#edf4fb!important;transform:none!important}
.btn-studportal{background:#eef4fb!important;color:var(--ns-blue)!important;border-color:#dce9f5!important}
.btn-adlog{background:var(--ns-navy)!important;color:#fff!important}
.btn-adlog:hover{background:#174b80!important}
.mobile-menu-toggle{display:none;align-items:center;justify-content:center;width:44px;height:44px;border:1px solid var(--ns-line);border-radius:12px;color:var(--ns-navy);background:white;cursor:pointer}
.hero{isolation:isolate;min-height:590px;max-width:1440px;margin:22px auto 0;border-radius:25px;padding:clamp(36px,6vw,90px);background:linear-gradient(100deg,rgba(8,35,70,.95) 0%,rgba(8,35,70,.82) 43%,rgba(8,35,70,.24) 100%),url('{{ asset('images/negrosorientalstateuniversity_cover.jpg') }}') center/cover no-repeat;box-shadow:var(--ns-shadow);overflow:hidden}
.hero:after{content:'';position:absolute;inset:auto -80px -210px auto;height:420px;width:420px;border:1px solid rgba(255,255,255,.2);border-radius:50%;pointer-events:none;z-index:-1}
.hero-content{margin:0;max-width:760px}
.hero-eyebrow{display:inline-flex;align-items:center;gap:10px;border:1px solid rgba(255,255,255,.3);border-radius:50px;background:rgba(255,255,255,.12);padding:10px 16px;color:#fff;font-size:.75rem;font-weight:800;letter-spacing:.12em;margin-bottom:24px}
.hero h1{font-family:'Plus Jakarta Sans',sans-serif;font-size:clamp(2.7rem,5.5vw,5.3rem);font-weight:800;letter-spacing:-.065em;line-height:1.08;text-shadow:none;max-width:740px}
.hero h1 span{color:#ffda87}
.hero p.hero-subtitle{font-family:'DM Sans',sans-serif;font-size:clamp(1rem,1.5vw,1.2rem);font-style:normal;font-weight:400;color:#e8eff8;line-height:1.75;max-width:570px;margin-top:24px;margin-bottom:24px;text-shadow:none}
.btn,.process-cta .btn{display:inline-flex;align-items:center;justify-content:center;gap:12px;border-radius:12px;font-weight:800;letter-spacing:-.01em;padding:15px 23px;box-shadow:none;transition:transform .2s,background .2s,box-shadow .2s}
.btn-yellow{background:var(--ns-gold);color:var(--ns-navy)}
.btn-yellow:hover{background:#ffd36b;box-shadow:0 12px 24px rgba(0,0,0,.12)}
.quick-links{background:transparent;padding:95px 24px 88px}
.section-intro{text-align:center;max-width:700px;margin:0 auto 36px}
.section-kicker{color:var(--ns-blue);font-size:.74rem;font-weight:800;letter-spacing:.17em}
.section-intro h2{font:800 clamp(1.9rem,3vw,2.75rem)/1.18 'Plus Jakarta Sans',sans-serif;letter-spacing:-.048em;color:var(--ns-navy);margin:12px 0}
.section-intro p{color:var(--ns-muted);line-height:1.7}
.quick-links-container{max-width:1220px;grid-template-columns:repeat(9,minmax(0,1fr));gap:12px}
.quick-link-item{min-height:118px;border:1px solid var(--ns-line);border-radius:16px;box-shadow:0 6px 18px rgba(13,45,76,.025)}
.quick-link-item:hover{border-color:#a9c7e5;box-shadow:0 12px 30px rgba(13,45,76,.1);transform:translateY(-4px)}
.quick-link-logo{width:100%;height:80px;max-width:86px}
.video-section{padding:100px 24px;background:#fff}
.video-section:before,.video-section:after,.process-section:before{display:none}
.video-content{max-width:1220px;grid-template-columns:1fr 1.1fr;gap:clamp(40px,5vw,90px);padding:0}
.video-text{padding:0}
.video-text h2,.process-header h2,.about-text h2{font:800 clamp(2rem,3.1vw,3rem)/1.16 'Plus Jakarta Sans',sans-serif;letter-spacing:-.05em;color:var(--ns-navy)}
.video-text h2::after,.process-header h2::after{display:none}
.video-text h3{font-size:1.05rem;color:var(--ns-blue);margin:20px 0}
.video-text p,.about-text p{font-family:'DM Sans',sans-serif;text-align:left;color:var(--ns-muted);line-height:1.85;font-size:1rem}
.btn-link{font-family:'DM Sans',sans-serif;color:var(--ns-blue);font-weight:800}
.video-container{height:auto;aspect-ratio:16/10;border-radius:20px;box-shadow:var(--ns-shadow)}
.video-container video{border-radius:20px}
.video-container:hover{transform:translateY(-4px);box-shadow:0 20px 50px rgba(20,52,88,.13)}
.process-section{padding:100px 24px;background:var(--ns-bg)}
.process-container{max-width:1220px}
.process-header{margin-bottom:52px}
.process-header h2{display:block}
.process-header p{font-family:'DM Sans',sans-serif;color:var(--ns-muted);font-size:1.06rem}
.process-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin:0}
.process-step{padding:33px 27px 30px;border:1px solid var(--ns-line);border-top:1px solid var(--ns-line);border-radius:18px;box-shadow:0 8px 28px rgba(16,47,86,.035)}
.process-step:hover{transform:translateY(-5px);border-color:#bfd5e9;box-shadow:var(--ns-shadow)}
.process-step-number{top:20px;left:22px;transform:none;width:34px;height:34px;font-size:.87rem;background:#e8f1fa;color:var(--ns-blue);box-shadow:none}
.process-step-icon{text-align:left;font-size:2.2rem;margin:41px 0 16px}
.process-step h3{font:800 1.1rem/1.4 'Plus Jakarta Sans',sans-serif;text-align:left;color:var(--ns-navy)}
.process-step p{text-align:left;font-family:'DM Sans',sans-serif;font-size:.92rem;color:var(--ns-muted)}
.certificate-types{border:1px solid var(--ns-line);border-radius:22px;box-shadow:var(--ns-shadow);padding:38px;margin-top:54px}
.certificate-types h3{font:800 1.65rem 'Plus Jakarta Sans',sans-serif;color:var(--ns-navy);text-align:left}
.certificate-list{grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
.certificate-item{border:1px solid var(--ns-line);border-left:3px solid var(--ns-gold);background:#fbfcff;border-radius:12px}
.certificate-item h4{font-family:'Plus Jakarta Sans',sans-serif;color:var(--ns-navy);font-size:1rem}
.certificate-item p{font-family:'DM Sans',sans-serif;color:var(--ns-muted)}
.process-cta .btn{background:var(--ns-navy);color:white;border-radius:12px;font-size:1rem;box-shadow:none}
.process-cta .btn:hover{background:var(--ns-blue);box-shadow:0 10px 22px rgba(16,47,86,.14)}
.about-section{background:#fff;padding:95px 24px}
.about-content{max-width:1220px;grid-template-columns:1.4fr 1fr;gap:72px}
.about-text h3{font-family:'Plus Jakarta Sans',sans-serif;color:var(--ns-blue);font-size:1.15rem}
.about-images{flex-direction:row;justify-content:center;flex-wrap:wrap;gap:18px}
.about-images img{width:min(45%,195px);height:190px;box-shadow:var(--ns-shadow);border:1px solid var(--ns-line);border-radius:18px}
.campus-section{background:var(--ns-navy);padding:65px 24px}
.campus-content{max-width:1220px}
.campus-info h2{font:800 2rem 'Plus Jakarta Sans',sans-serif}
.campus-image{border-radius:18px;font-size:4rem;color:var(--ns-gold)}
:focus-visible{outline:3px solid #de9d26!important;outline-offset:3px}
@media(max-width:1150px){.nav-menu{gap:3px}.nav-menu button{padding:10px!important;font-size:.76rem}.quick-links-container{grid-template-columns:repeat(5,minmax(0,1fr))}}
@media(max-width:900px){.mobile-menu-toggle{display:flex;margin-left:auto}.nav-container{flex-wrap:wrap}.nav-menu{display:none;width:100%;flex-basis:100%;flex-direction:column;align-items:stretch;padding:12px 0}.nav-menu.is-open{display:flex}.nav-menu li,.nav-menu a,.nav-menu button{width:100%}.nav-menu button{justify-content:flex-start;font-size:.92rem;padding:13px 15px!important}.hero{margin:16px 16px 0;min-height:520px}.video-content,.about-content,.campus-content{grid-template-columns:1fr;gap:34px}.process-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.video-container{max-width:700px}.quick-links-container{grid-template-columns:repeat(3,minmax(0,1fr))}.about-images{justify-content:flex-start}}
@media(max-width:600px){.nav-container{padding:12px 17px}.nav-logo{min-width:0}.nav-logo img{width:40px;height:40px}.nav-brand{font-size:.83rem}.nav-subtitle{font-size:.65rem}.hero{margin:12px 12px 0;min-height:530px;padding:45px 25px;background-position:60% center}.hero h1{font-size:clamp(2.45rem,10vw,3.3rem)}.hero-eyebrow{font-size:.62rem;letter-spacing:.07em}.hero-buttons .btn{width:100%;font-size:.95rem}.quick-links,.video-section,.process-section,.about-section{padding:65px 18px}.quick-links-container{gap:10px}.quick-link-item{padding:10px;min-height:90px}.quick-link-logo{height:55px}.process-grid,.certificate-list{grid-template-columns:1fr}.process-step{padding:28px 24px}.certificate-types{padding:25px 18px}.about-images img{height:140px}.campus-section{padding:45px 20px}.video-container{aspect-ratio:16/9}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{transition-duration:.01ms!important;animation-duration:.01ms!important}}

	</style>
{% endblock %}

{% block body %}
	<!-- Navigation -->
	<nav class="navbar" aria-label="Main navigation">
		<div class="nav-container">
			<a href="#top" class="nav-logo">
				<img src="{{ asset('images/scholarship.png') }}" alt="NORSU Logo">
				<div class="nav-brand-wrapper">
					<span class="nav-brand">NORSU SCHOLARSHIP</span>
					<span class="nav-subtitle">Public Scholarship Services</span>
				</div>
			</a>
			<button class="mobile-menu-toggle" type="button" aria-label="Toggle navigation" aria-expanded="false" aria-controls="primary-navigation"><i class="fa-solid fa-bars"></i></button>
			<ul class="nav-menu" id="primary-navigation">
				<li>
					<button class="btn-prog" type="button" onclick="document.getElementById('programs').scrollIntoView({behavior:'smooth'})">
						<i class="fa-solid fa-list"></i>
						Programs</button>
				</li>
				<li>
					<button class="btn-acscho">
						<i class="fa-solid fa-user-graduate"></i>
						Accepted Scholars</button>
				</li>
				<li>
					<button class="btn-track">
						<i class="fa-solid fa-magnifying-glass"></i>
						Track Application</button>
				</li>
				<li>
					<a href="{{ path('student_register') }}" style="text-decoration: none;">
						<button class="btn-studportal">
							<i class="fa-solid fa-people-group"></i>
							Student Portal</button>
					</a>
				</li>
				<li>
					<a href="{{ path('admin_login') }}" style="text-decoration: none;">
						<button class="btn-adlog" type="button">
							<i class="fa-solid fa-right-to-bracket"></i>
							Admin Login</button>
					</a>
				</li>
			</ul>
		</div>
	</nav>

	<!-- Hero Section -->
	<section class="hero" id="top">
		<div class="hero-content">
			<span class="hero-eyebrow"><i class="fa-solid fa-graduation-cap"></i> STUDENT OPPORTUNITIES</span>
			<h1>Your future starts <span>with opportunity.</span></h1>
			<p class="hero-subtitle">Explore scholarship opportunities and access student services at Negros Oriental State University.</p>
			<div class="hero-buttons">
				<a href="{{ path('student_register') }}" style="text-decoration: none;">
					<button class="btn btn-yellow"> Register Now <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
				</a>
			</div>
		</div>
	</section>

	<!-- Quick Links -->
	<!-- Scholarship Partners -->
	<section class="quick-links" id="programs">
		<div class="section-intro"><span class="section-kicker">SCHOLARSHIP OPPORTUNITIES</span><h2>Explore scholarship programs</h2><p>Discover available scholarship programs and partner organizations.</p></div>
		<div class="quick-links-container">
			<a href="{{ path('app_scholarship_detail', {slug: 'acef-giahep'}) }}" class="quick-link-item">
				<div class="quick-link-logo">
					<img src="{{ asset('images/quicklinks/ACEF-GIAHEP LOGO-modified.png') }}" alt="ACEF-GIAHEP">
				</div>
			</a>
			<a href="{{ path('app_scholarship_detail', {slug: 'cmsp'}) }}" class="quick-link-item">
				<div class="quick-link-logo">
					<img src="{{ asset('images/quicklinks/CMSP-modified.png') }}" alt="CMSP">
				</div>
			</a>
			<a href="{{ path('app_scholarship_detail', {slug: 'coscho'}) }}" class="quick-link-item">
				<div class="quick-link-logo">
					<img src="{{ asset('images/quicklinks/COSCHO LOGO-modified.png') }}" alt="COSCHO">
				</div>
			</a>
			<a href="{{ path('app_scholarship_detail', {slug: 'landbank'}) }}" class="quick-link-item">
				<div class="quick-link-logo">
					<img src="{{ asset('images/quicklinks/LANDBANK LOGO-modified.png') }}" alt="Land Bank">
				</div>
			</a>
			<a href="{{ path('app_scholarship_detail', {slug: 'ngcp'}) }}" class="quick-link-item">
				<div class="quick-link-logo">
					<img src="{{ asset('images/quicklinks/NGCP LOGO-modified.png') }}" alt="NGCP">
				</div>
			</a>
			<a href="{{ path('app_scholarship_detail', {slug: 'sida-sgp'}) }}" class="quick-link-item">
				<div class="quick-link-logo">
					<img src="{{ asset('images/quicklinks/SIDA-SGP LOGO-modified.png') }}" alt="SIDA-SGP">
				</div>
			</a>
			<a href="{{ path('app_scholarship_detail', {slug: 'tdp'}) }}" class="quick-link-item">
				<div class="quick-link-logo">
					<img src="{{ asset('images/quicklinks/TDP logo-modified.png') }}" alt="TDP">
				</div>
			</a>
			<a href="{{ path('app_scholarship_detail', {slug: 'tes'}) }}" class="quick-link-item">
				<div class="quick-link-logo">
					<img src="{{ asset('images/quicklinks/TES LOGO-modified.png') }}" alt="TES">
				</div>
			</a>
			<a href="{{ path('app_scholarship_detail', {slug: 'pldt'}) }}" class="quick-link-item">
				<div class="quick-link-logo">
					<img src="{{ asset('images/quicklinks/PLDT-Logo.png') }}" alt="PLDT">
				</div>
			</a>
		</div>
	</section>


	<!-- Video Section -->
	<section class="video-section" id="about-scholarships">
		<div class="video-content">
			<div class="video-text">
				<h2>About NORSU Scholarship Program</h2>
				<h3>Empowering Students Through Education</h3>
				<p>The Negros Oriental State University Scholarship Program provides financial assistance to deserving
					                students, helping them achieve their academic goals and build a brighter future.</p>
				<p>Watch our video to learn more about how we support students in their educational journey and the
					                opportunities available through our scholarship programs.</p>
				<a href="#about-norsu" class="btn-link">Learn more about NORSU <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
			</div>
			<div class="video-container">
				<video controls preload="metadata" playsinline>
					<source src="{{ asset('video/scholarship-norsu.mp4') }}" type="video/mp4">
					Your browser does not support the video tag.
				</video>
			</div>
		</div>
	</section>

	<!-- About Section -->
	<section class="about-section" id="about-norsu">
		<div class="about-content">
			<div class="about-text">
				<h2>About Negros Oriental State University</h2>
				<h3>Education that opens doors</h3>
				<p>Negros Oriental State University serves students across Negros Oriental through its academic programs and campus community.</p>
				<p>This scholarship portal helps students explore opportunities, find information about financial assistance, and access relevant student services.</p>
				<a href="#programs" class="btn-link">Explore scholarship programs →</a>
			</div>
			<div class="about-images">
				<img src="{{ asset('images/scholarship.png') }}" alt="NORSU Logo">
				<img src="{{ asset('images/norsu.png') }}" alt="NORSU Logo">

			</div>
		</div>
	</section>

	<!-- Campus Section -->
	<section class="campus-section">
		<div class="campus-content">
			<div class="campus-info">
				<h2>Our Campus</h2>
				<div class="campus-location">
					<span>📍</span>
					<span>Negros Oriental, Philippines</span>
				</div>
			</div>
			<div class="campus-image"><i class="fa-solid fa-building-columns" aria-hidden="true"></i></div>
		</div>
	</section>

	<!-- FAQ Section -->
	<section class="faq-section" id="faq">
		<div class="faq-container">
			<div class="faq-header">
				<span class="section-kicker">HELP & SUPPORT</span>
				<h2>Frequently Asked Questions</h2>
				<p>Find answers to common questions about scholarships, applications, and our services.</p>
			</div>

			<div class="faq-grid">
				<div class="faq-category">
					<h3><i class="fa-solid fa-clipboard-check"></i> Eligibility & Requirements</h3>

					<div class="faq-item">
						<button class="faq-question" aria-expanded="false">
							<span>Who is eligible to apply for scholarships?</span>
							<i class="fa-solid fa-chevron-down"></i>
						</button>
						<div class="faq-answer">
							<p>Eligibility requirements vary by scholarship program. Generally, applicants must be enrolled or planning to enroll at NORSU, maintain a minimum GPA, and demonstrate financial need. Some scholarships have specific requirements based on course, year level, or other criteria. Check individual scholarship program pages for detailed eligibility requirements.</p>
						</div>
					</div>

					<div class="faq-item">
						<button class="faq-question" aria-expanded="false">
							<span>What documents do I need to apply?</span>
							<i class="fa-solid fa-chevron-down"></i>
						</button>
						<div class="faq-answer">
							<p>Common requirements include: Certificate of Registration, Official Transcript of Records, Certificate of Indigency or Income Tax Return, Birth Certificate, Recent ID Photo, and Recommendation Letters. Specific requirements may vary by scholarship program. Prepare all documents in PDF or image format for online submission.</p>
						</div>
					</div>

					<div class="faq-item">
						<button class="faq-question" aria-expanded="false">
							<span>Can I apply for multiple scholarships?</span>
							<i class="fa-solid fa-chevron-down"></i>
						</button>
						<div class="faq-answer">
							<p>Yes, you may apply for multiple scholarship programs as long as you meet the eligibility requirements for each. However, you can only be awarded one scholarship at a time. If selected for multiple scholarships, you'll be asked to choose one to accept.</p>
						</div>
					</div>
				</div>

				<div class="faq-category">
					<h3><i class="fa-solid fa-file-lines"></i> Application Process</h3>

					<div class="faq-item">
						<button class="faq-question" aria-expanded="false">
							<span>How do I check my application status?</span>
							<i class="fa-solid fa-chevron-down"></i>
						</button>
						<div class="faq-answer">
							<p>Log in to your Student Portal account and navigate to the "My Applications" section. You'll see the current status of all your scholarship applications (Pending, Under Review, Approved, or Rejected). You'll also receive email notifications when your application status changes.</p>
						</div>
					</div>

					<div class="faq-item">
						<button class="faq-question" aria-expanded="false">
							<span>When will I know if I've been selected?</span>
							<i class="fa-solid fa-chevron-down"></i>
						</button>
						<div class="faq-answer">
							<p>Application processing times vary by scholarship program, typically ranging from 2-6 weeks after the application deadline. Successful applicants will be notified via email and their names will be posted on the Accepted Scholars list. You can also track your application status through the Student Portal.</p>
						</div>
					</div>

					<div class="faq-item">
						<button class="faq-question" aria-expanded="false">
							<span>What happens after I'm awarded a scholarship?</span>
							<i class="fa-solid fa-chevron-down"></i>
						</button>
						<div class="faq-answer">
							<p>After being awarded a scholarship, you'll receive an acceptance letter with detailed information about your grant, disbursement schedule, and obligations. You must sign and return the acceptance form, comply with maintaining required GPA and attendance, and submit progress reports as required by your scholarship program.</p>
						</div>
					</div>
				</div>

				<div class="faq-category">
					<h3><i class="fa-solid fa-circle-question"></i> General Information</h3>

					<div class="faq-item">
						<button class="faq-question" aria-expanded="false">
							<span>Is there an application fee?</span>
							<i class="fa-solid fa-chevron-down"></i>
						</button>
						<div class="faq-answer">
							<p>No, scholarship applications through the e-Scholar portal are completely free. You do not need to pay any fees to apply for scholarships. Be cautious of any third party claiming to charge fees for scholarship applications.</p>
						</div>
					</div>

					<div class="faq-item">
						<button class="faq-question" aria-expanded="false">
							<span>How do I update my profile information?</span>
							<i class="fa-solid fa-chevron-down"></i>
						</button>
						<div class="faq-answer">
							<p>Log in to your Student Portal and go to "Profile Settings." You can update your contact information, address, and other personal details. For changes to official records like name or date of birth, contact the Scholarship Office with supporting documents.</p>
						</div>
					</div>

					<div class="faq-item">
						<button class="faq-question" aria-expanded="false">
							<span>What if I have technical issues with the portal?</span>
