				<div class="quick-link-logo">
					<img src="{{ asset('images/quicklinks/SIDA-SGP LOGO-modified.png') }}" alt="SIDA-SGP">
				</div>
			</a>
			<a href="{{ path('app_scholarship_detail', {slug: 'tdp'}) }}" class="quick-link-item">
				<div class="quick-link-logo">
					<img src="{{ asset('images/quicklinks/TDP logo-modified.png') }}" alt="TDP">
				</div>
			</a>
			<a href="{{ path('app_scholarship_detail', {slug: 'tes'}) }}" class="quick-link-item">
				<div class="quick-link-logo">
					<img src="{{ asset('images/quicklinks/TES LOGO-modified.png') }}" alt="TES">
				</div>
			</a>
			<a href="{{ path('app_scholarship_detail', {slug: 'pldt'}) }}" class="quick-link-item">
				<div class="quick-link-logo">
					<img src="{{ asset('images/quicklinks/PLDT-Logo.png') }}" alt="PLDT">
				</div>
			</a>
		</div>
	</section>


	<!-- Video Section -->
	<section class="video-section" id="about-scholarships">
		<div class="video-content">
			<div class="video-text">
				<h2>About NORSU Scholarship Program</h2>
				<h3>Empowering Students Through Education</h3>
				<p>The Negros Oriental State University Scholarship Program provides financial assistance to deserving
					                students, helping them achieve their academic goals and build a brighter future.</p>
				<p>Watch our video to learn more about how we support students in their educational journey and the
					                opportunities available through our scholarship programs.</p>
				<a href="#document-requests" class="btn-link">How document requests work <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
			</div>
			<div class="video-container">
				<video controls preload="metadata" playsinline>
					<source src="{{ asset('video/scholarship-norsu.mp4') }}" type="video/mp4">
					Your browser does not support the video tag.
				</video>
			</div>
		</div>
	</section>

	<!-- Document Request Process Section -->
	<section class="process-section" id="document-requests">
		<div class="process-container">
			<div class="process-header">
				<h2>Certificate Request Process</h2>
				<p>Follow these simple steps to request certificates and documents from the Scholarship Office. We're here
					                to support your needs efficiently and professionally.</p>
			</div>

			<div class="process-grid">
				<div class="process-step">
					<div class="process-step-number">1</div>
					<div class="process-step-icon">📝</div>
					<h3>Login to Portal</h3>
					<p>Access your student portal using your credentials. Navigate to the "Document Request" section in your
						                    dashboard.</p>
				</div>

				<div class="process-step">
					<div class="process-step-number">2</div>
					<div class="process-step-icon">📋</div>
					<h3>Select Certificate Type</h3>
					<p>Choose the type of certificate you need from the available options (e.g., Certificate of Scholarship,
						                    Certificate of Good Standing).</p>
				</div>

				<div class="process-step">
					<div class="process-step-number">3</div>
					<div class="process-step-icon">✏️</div>
					<h3>Fill Out Request Form</h3>
					<p>Complete the request form with accurate information. Include the purpose of the certificate and any
						                    specific requirements.</p>
				</div>

				<div class="process-step">
					<div class="process-step-number">4</div>
					<div class="process-step-icon">💳</div>
					<h3>Submit & Pay Fees</h3>
					<p>Submit your request and pay the applicable processing fees through the available payment methods.</p>
				</div>

				<div class="process-step">
					<div class="process-step-number">5</div>
					<div class="process-step-icon">⏳</div>
					<h3>Wait for Processing</h3>
					<p>Your request will be processed within 3-5 business days. You'll receive notifications via email and
						                    SMS.</p>
				</div>

				<div class="process-step">
					<div class="process-step-number">6</div>
					<div class="process-step-icon">✅</div>
					<h3>Claim Your Document</h3>
					<p>Once ready, you can claim your certificate at the Scholarship Office or request delivery to your
						                    address.</p>
				</div>
			</div>

			<div class="certificate-types">
				<h3>Available Certificates & Documents</h3>
				<div class="certificate-list">
					<div class="certificate-item">
						<h4>📜 Certificate of Scholarship</h4>
						<p>Official certification of your scholarship status and benefits received.</p>
					</div>
					<div class="certificate-item">
						<h4>📜 Certificate of Good Standing</h4>
						<p>Verification that you maintain good academic and disciplinary standing as a scholar.</p>
					</div>
					<div class="certificate-item">
						<h4>📜 Scholarship Transcript</h4>
						<p>Detailed record of scholarship grants, amounts, and duration.</p>
					</div>
					<div class="certificate-item">
						<h4>📜 Certificate of Completion</h4>
						<p>Document certifying successful completion of scholarship requirements and obligations.</p>
					</div>
				</div>
			</div>

			<div class="process-cta">
				<a class="btn" href="{{ path('student_register') }}">Go to Student Portal <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
