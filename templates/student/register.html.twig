{% extends 'base.html.twig' %}

{% block title %}Student Registration - e-Scholar NORSU{% endblock %}

{% block body %}
<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Poppins', sans-serif;
        background: linear-gradient(135deg, #1e5ba8 0%, #2c7ac7 100%);
        min-height: 100vh;
        padding: 2rem 0;
    }

    .registration-container {
        max-width: 900px;
        margin: 0 auto;
        background: white;
        border-radius: 15px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.2);
        overflow: hidden;
    }

    .registration-header {
        background: linear-gradient(135deg, #1e5ba8 0%, #2c7ac7 100%);
        color: white;
        padding: 2.5rem 2rem;
        text-align: center;
    }

    .registration-header h1 {
        font-size: 2rem;
        margin-bottom: 0.5rem;
    }

    .registration-header p {
        font-size: 1rem;
        opacity: 0.95;
    }

    .form-container {
        padding: 3rem 2.5rem;
    }

    .form-section {
        margin-bottom: 2.5rem;
    }

    .form-section h2 {
        color: #1e5ba8;
        font-size: 1.3rem;
        margin-bottom: 1.5rem;
        padding-bottom: 0.5rem;
        border-bottom: 3px solid #ffc107;
    }

    .form-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    .form-group label {
        font-weight: 500;
        color: #333;
        margin-bottom: 0.5rem;
        font-size: 0.95rem;
    }

    .form-group input,
    .form-group select,
    .form-group textarea {
        padding: 0.75rem;
        border: 2px solid #e0e0e0;
        border-radius: 8px;
        font-size: 1rem;
        font-family: 'Poppins', sans-serif;
        transition: all 0.3s ease;
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
        outline: none;
        border-color: #1e5ba8;
        box-shadow: 0 0 0 3px rgba(30, 91, 168, 0.1);
    }

    .form-group input[type="file"] {
        padding: 0.5rem;
    }

    .form-group textarea {
        resize: vertical;
        min-height: 80px;
    }

    .submit-container {
        text-align: center;
        margin-top: 2rem;
    }

    .btn-submit {
        background: linear-gradient(135deg, #ffc107 0%, #ffb300 100%);
        color: #1e5ba8;
        padding: 1rem 3rem;
        border: none;
        border-radius: 50px;
        font-size: 1.1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(255, 193, 7, 0.4);
    }

    .btn-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(255, 193, 7, 0.6);
    }

    .alert {
        padding: 1rem 1.5rem;
        border-radius: 8px;
        margin-bottom: 2rem;
    }

    .alert-success {
        background: #d4edda;
        color: #155724;
        border-left: 4px solid #28a745;
    }

    .alert-error {
        background: #f8d7da;
        color: #721c24;
        border-left: 4px solid #dc3545;
    }

    .back-link {
        display: inline-block;
        margin-bottom: 2rem;
        color: white;
        text-decoration: none;
        font-weight: 500;
        padding: 0.5rem 1rem;
        background: rgba(255,255,255,0.2);
        border-radius: 8px;
        transition: all 0.3s ease;
    }

    .back-link:hover {
        background: rgba(255,255,255,0.3);
    }

    @media (max-width: 768px) {
        .registration-container {
            margin: 0 1rem;
        }

        .form-container {
            padding: 2rem 1.5rem;
        }

        .registration-header h1 {
            font-size: 1.5rem;
        }

        .form-row {
            grid-template-columns: 1fr;
        }
    }
</style>

<div style="max-width: 1400px; margin: 0 auto; padding: 0 2rem;">
    <a href="{{ path('app_landing') }}" class="back-link">← Back to Home</a>

    <div class="registration-container">
        <div class="registration-header">
            <h1>📋 Student Scholarship Registration</h1>
            <p>e-Scholar: Integrated Scholarship Data Management System</p>
        </div>

        <div class="form-container">
            {% for message in app.flashes('success') %}
                <div class="alert alert-success">{{ message }}</div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                <div class="alert alert-error">{{ message }}</div>
            {% endfor %}

            {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}

            <!-- Scholarship Information -->
            <div class="form-section">
                <h2>🎓 Scholarship Information</h2>
                <div class="form-row">
                    <div class="form-group">
                        {{ form_label(form.studentNumber) }}
                        {{ form_widget(form.studentNumber) }}
                    </div>
                    <div class="form-group">
                        {{ form_label(form.scholarshipType) }}
                        {{ form_widget(form.scholarshipType) }}
                    </div>
                </div>
            </div>

            <!-- Personal Information -->
            <div class="form-section">
                <h2>👤 Personal Information</h2>
                <div class="form-row">
                    <div class="form-group">
                        {{ form_label(form.firstName) }}
                        {{ form_widget(form.firstName) }}
                    </div>
                    <div class="form-group">
                        {{ form_label(form.middleName) }}
                        {{ form_widget(form.middleName) }}
                    </div>
                    <div class="form-group">
                        {{ form_label(form.lastName) }}
                        {{ form_widget(form.lastName) }}
                    </div>
                    <div class="form-group">
                        {{ form_label(form.extensionName) }}
                        {{ form_widget(form.extensionName) }}
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        {{ form_label(form.dateOfBirth) }}
                        {{ form_widget(form.dateOfBirth) }}
                    </div>
                    <div class="form-group">
                        {{ form_label(form.placeOfBirth) }}
                        {{ form_widget(form.placeOfBirth) }}
                    </div>
                    <div class="form-group">
                        {{ form_label(form.sex) }}
                        {{ form_widget(form.sex) }}
                    </div>
                    <div class="form-group">
                        {{ form_label(form.civilStatus) }}
                        {{ form_widget(form.civilStatus) }}
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        {{ form_label(form.religion) }}
                        {{ form_widget(form.religion) }}
                    </div>
                    <div class="form-group">
                        {{ form_label(form.profilePicture) }}
                        {{ form_widget(form.profilePicture) }}
                    </div>
                </div>
            </div>

            <!-- Academic Information -->
            <div class="form-section">
                <h2>🏫 Academic Information</h2>
                <div class="form-row">
                    <div class="form-group">
                        {{ form_label(form.campus) }}
                        {{ form_widget(form.campus) }}
                    </div>
                    <div class="form-group">
                        {{ form_label(form.course) }}
                        {{ form_widget(form.course) }}
                    </div>
                    <div class="form-group">
                        {{ form_label(form.yearLevel) }}
                        {{ form_widget(form.yearLevel) }}
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        {{ form_label(form.gwa) }}
                        {{ form_widget(form.gwa) }}
                    </div>
                    <div class="form-group">
                        {{ form_label(form.semester) }}
                        {{ form_widget(form.semester) }}
                    </div>
                    <div class="form-group">
                        {{ form_label(form.academicYear) }}
                        {{ form_widget(form.academicYear) }}
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        {{ form_label(form.highSchool) }}
                        {{ form_widget(form.highSchool) }}
                    </div>
                    <div class="form-group">
                        {{ form_label(form.highSchoolYear) }}
                        {{ form_widget(form.highSchoolYear) }}
                    </div>
                </div>
            </div>

            <!-- Contact Information -->
            <div class="form-section">
                <h2>📞 Contact Information</h2>
                <div class="form-row">
                    <div class="form-group">
                        {{ form_label(form.email) }}
                        {{ form_widget(form.email) }}
                    </div>
                    <div class="form-group">
                        {{ form_label(form.contactNumber) }}
                        {{ form_widget(form.contactNumber) }}
                    </div>
                    <div class="form-group">
                        {{ form_label(form.alternateContactNumber) }}
                        {{ form_widget(form.alternateContactNumber) }}
                    </div>
                </div>
            </div>

            <!-- Address Information -->
            <div class="form-section">
                <h2>📍 Address Information</h2>
                <div class="form-row">
                    <div class="form-group">
                        {{ form_label(form.permanentAddress) }}
                        {{ form_widget(form.permanentAddress) }}
                    </div>
                    <div class="form-group">
                        {{ form_label(form.currentAddress) }}
                        {{ form_widget(form.currentAddress) }}
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        {{ form_label(form.barangay) }}
                        {{ form_widget(form.barangay) }}
                    </div>
                    <div class="form-group">
                        {{ form_label(form.municipality) }}
                        {{ form_widget(form.municipality) }}
                    </div>
                    <div class="form-group">
                        {{ form_label(form.province) }}
                        {{ form_widget(form.province) }}
                    </div>
                    <div class="form-group">
                        {{ form_label(form.zipCode) }}
                        {{ form_widget(form.zipCode) }}
                    </div>
                </div>
            </div>

            <!-- Family Information -->
            <div class="form-section">
                <h2>👨‍👩‍👧‍👦 Family Information</h2>
                <div class="form-row">
                    <div class="form-group">
                        {{ form_label(form.fatherName) }}
                        {{ form_widget(form.fatherName) }}
                    </div>
                    <div class="form-group">
                        {{ form_label(form.fatherOccupation) }}
                        {{ form_widget(form.fatherOccupation) }}
                    </div>
                    <div class="form-group">
                        {{ form_label(form.fatherContactNumber) }}
                        {{ form_widget(form.fatherContactNumber) }}
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        {{ form_label(form.motherName) }}
                        {{ form_widget(form.motherName) }}
                    </div>
                    <div class="form-group">
                        {{ form_label(form.motherOccupation) }}
                        {{ form_widget(form.motherOccupation) }}
                    </div>
                    <div class="form-group">
                        {{ form_label(form.motherContactNumber) }}
                        {{ form_widget(form.motherContactNumber) }}
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        {{ form_label(form.guardianName) }}
                        {{ form_widget(form.guardianName) }}
                    </div>
                    <div class="form-group">
                        {{ form_label(form.guardianRelationship) }}
                        {{ form_widget(form.guardianRelationship) }}
                    </div>
                    <div class="form-group">
                        {{ form_label(form.guardianContactNumber) }}
                        {{ form_widget(form.guardianContactNumber) }}
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        {{ form_label(form.numberOfSiblings) }}
                        {{ form_widget(form.numberOfSiblings) }}
                    </div>
                    <div class="form-group">
                        {{ form_label(form.familyMonthlyIncome) }}
                        {{ form_widget(form.familyMonthlyIncome) }}
                    </div>
                </div>
            </div>

            <div class="submit-container">
                <button type="submit" class="btn-submit">Submit Application</button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
